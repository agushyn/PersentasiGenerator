{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Arya Duta Persentasion Studio",
  "version": "0.1.0",
  "identifier": "com.aryaduta.persentasionstudio",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Arya Duta Persentasion Studio",
        "width": 1280,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 700,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"],
    "resources": {
      "resources/pptx-engine/cli.cjs": "pptx-engine/cli.cjs"
    },
    "externalBin": ["binaries/node"]
  }
}
